    }

    COUPONS {
        VARCHAR coupon_code PK
        VARCHAR applies_to
        NUMERIC discount_pct
        NUMERIC max_discount
        DATE valid_from
        DATE valid_to
    }

    BOOKINGS {
        INTEGER booking_id PK
        VARCHAR booking_ref UK
        INTEGER customer_id FK
        VARCHAR booking_type
