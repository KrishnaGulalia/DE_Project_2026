    HOTELS {
        INTEGER hotel_id PK
        TEXT hotel_name
        TEXT city_name
        SMALLINT star_rating
        NUMERIC user_rating
        JSONB amenities
        TIME check_in_time
        TIME check_out_time
    }

    ROOM_TYPES {
        INTEGER room_type_id PK
        INTEGER hotel_id FK
        TEXT room_name
        SMALLINT max_guests
        NUMERIC price_per_night
        INTEGER total_rooms
    }

    CUSTOMERS {
        INTEGER customer_id PK
        TEXT full_name
        TEXT email UK
        VARCHAR phone UK
        VARCHAR loyalty_tier
        TIMESTAMPTZ created_at
    }

    FLIGHTS {
        INTEGER flight_id PK
        VARCHAR airline_code FK
        VARCHAR flight_no
