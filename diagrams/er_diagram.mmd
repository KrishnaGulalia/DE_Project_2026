        NUMERIC total_amount
        VARCHAR coupon_code FK
        NUMERIC discount
        VARCHAR payment_method
        VARCHAR status
        TIMESTAMPTZ cancelled_at
        NUMERIC refund_amount
    }

    FLIGHT_BOOKINGS {
        INTEGER booking_id PK, FK
        INTEGER flight_id FK
        VARCHAR cabin
        SMALLINT passengers
        NUMERIC fare_paid
    }

    PASSENGERS {
        INTEGER booking_id PK, FK
        SMALLINT seq_no PK
        TEXT full_name
        SMALLINT age
        VARCHAR gender
        VARCHAR seat_no
    }

    HOTEL_BOOKINGS {
        INTEGER booking_id PK, FK
        INTEGER hotel_id FK
        INTEGER room_type_id FK
        DATE check_in
        DATE check_out
        INTEGER rooms
        INTEGER guests
        VARCHAR room_number
    }

    HOTEL_REVIEWS {
        INTEGER review_id PK
        INTEGER booking_id FK
        INTEGER hotel_id FK
        SMALLINT rating
        TEXT title
        TEXT review_text
        TIMESTAMPTZ created_at
    }

